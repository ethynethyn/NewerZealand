  <library_effects>
    <effect id="Material_004-effect">
      <profile_COMMON>
        <newparam sid="Window_png-surface">
          <surface type="2D">
            <init_from>Window_png</init_from>
          </surface>
        </newparam>
        <newparam sid="Window_png-sampler">
